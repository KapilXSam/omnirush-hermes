# omnirush-hermes configuration — copy to .env if you prefer env files over the service.
# NOTHING HERE IS A REAL SECRET: the OmniRush OAuth token is never an env var, it lives
# only in ~/.omnirush-proxy/tokens.json (mode 600). These are local settings.

# Port the proxy listens on. Clients point at http://127.0.0.1:<port>/v1
OMNIRUSH_PROXY_PORT=20129

# Bearer key clients must send. Local dummy by default — change it if you ever bind
# off-loopback (see examples/other-clients.md).
OMNIRUSH_PROXY_KEY=sk-omnirush

# Host to bind. Keep 127.0.0.1 unless you know why you are changing it.
OMNIRUSH_PROXY_HOST=127.0.0.1

# Upstream gateway.
OMNIRUSH_GATEWAY_URL=https://omnirush.ai/omnirush/v1

# Official client version to present upstream. Leave empty to auto-detect from npm
# (recommended — the gateway refuses stale versions).
# OMNIRUSH_CLIENT_VERSION=

# Token store and the file to seed it from.
OMNIRUSH_PROXY_STORE=~/.omnirush-proxy/tokens.json
OMNIRUSH_SEED_STORE=~/.omnirush2api/tokens.json

# Abort an upstream stream that goes quiet for this many ms (0 disables).
OMNIRUSH_IDLE_TIMEOUT_MS=180000
